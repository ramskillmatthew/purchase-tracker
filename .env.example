# Free "Basic" tier at twelvedata.com — required for live stock/ETF prices in Investments.
# Without it, stock holdings simply show as not-yet-priced; every other Investments feature works regardless.
TWELVE_DATA_API_KEY=
# Free tier at eodhd.com — required for LSE-listed ETF prices in Investments
# (Twelve Data's Basic plan doesn't cover ordinary LSE instruments; confirmed
# live — see lib/investments/providers/eodhd.ts's own comment). Without it,
# LSE holdings (e.g. VWRP/V3AB/VUAG) fall back to their purchase price.
EODHD_API_KEY=
